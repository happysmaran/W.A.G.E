{
  "name": "WAGE",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build:ui": "next build",
    "build:api": "cd jobradar-api && python3 build_backend.py",
    "build:app": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build": "npm run build:ui && npm run build:api && npm run build:app",
    "start": "next start",
    "lint": "next lint",
    "electron:start": "electron ."
  },
  "build": {
    "appId": "com.wage.app",
    "productName": "WAGE",
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "jobradar-api/dist/wage-backend",
        "to": "wage-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}
