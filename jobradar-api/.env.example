# Copy to .env and adjust. All variables are optional — sensible defaults
# are baked in (see app/config.py) so the app runs with zero config in mock mode.

# --- Ollama connection ---
# Local install: leave as-is. Ollama Cloud: point at https://ollama.com and set an API key.
WAGE_OLLAMA_BASE_URL=http://localhost:11434
WAGE_OLLAMA_API_KEY=

# Chat/reasoning model — used for gap analysis, bullet tailoring, outreach drafts.
WAGE_OLLAMA_MODEL=llama3.1:8b

# Embedding model — MUST be an embedding-capable model, not a chat model.
# Chat models (deepseek-r1, llama3.1, gpt-oss) return a 500 if you try to embed with them.
WAGE_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Context window cap sent with every chat request. Keeps Ollama's KV cache
# allocation small and predictable — raise this if you have VRAM to spare
# and want more context for longer job descriptions.
WAGE_OLLAMA_NUM_CTX=2048

# --- Job feeds (automatic ingestion) ---
# The feed poller subscribes to public ATS board APIs (Greenhouse / Lever /
# Ashby) per company and stages new postings for review on a timer.
WAGE_FEED_POLL_ENABLED=true
WAGE_FEED_POLL_INTERVAL_SECONDS=1800
# true: feed fetchers return canned postings instead of hitting the real APIs.
WAGE_MOCK_SCRAPER=false

# --- Dev / testing ---
# true: every LLM call returns deterministic canned data, no Ollama needed.
# Set false once you have a real Ollama instance reachable.
WAGE_MOCK_LLM=true
